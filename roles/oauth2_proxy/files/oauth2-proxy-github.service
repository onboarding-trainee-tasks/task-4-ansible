[Unit]
Description=OAuth2 Proxy GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

User=oauth2-proxy
Group=oauth2-proxy

ExecStart=/usr/local/bin/oauth2-proxy \
  --config=/etc/oauth2-proxy/github.cfg

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target